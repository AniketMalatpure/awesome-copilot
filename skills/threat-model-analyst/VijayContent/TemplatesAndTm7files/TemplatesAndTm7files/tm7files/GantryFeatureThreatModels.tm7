a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>K8S-Bridge may be spoofed by an attacker and this may lead to unauthorized access to Kubernetes API Server. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>4. VM Custom Resource is created in the ARB Kubernetes Cluster (CR).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cac98448-ef65-4967-8db3-6c6605543a76</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>e8b47e36-aff7-422e-8758-5b75d3f94463</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E704a79eec-77ec-4a54-8692-7a2c1a862ba70acccaf2-2a61-4d48-9b95-4be00fd30d357ca2df41-2d15-433b-afdc-476e1cb40eef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>0acccaf2-2a61-4d48-9b95-4be00fd30d35</b:FlowGuid><b:Id>497</b:Id><b:InteractionKey>04a79eec-77ec-4a54-8692-7a2c1a862ba7:0acccaf2-2a61-4d48-9b95-4be00fd30d35:7ca2df41-2d15-433b-afdc-476e1cb40eef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in azlocal-vmc</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into azlocal-vmc in order to change the flow of program execution within azlocal-vmc to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>10. vmc binary is injected via iso 12. mTLS certs are injected via TLS encrypted RPC. 14. EnableArcAgent gRPC API is invoked with the required config as args including the rsa private key from step 7. 18. short lived TLS cert is rotated in exchange for a long lived leaf cert (1 year)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>04a79eec-77ec-4a54-8692-7a2c1a862ba7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7ca2df41-2d15-433b-afdc-476e1cb40eef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E604a79eec-77ec-4a54-8692-7a2c1a862ba70acccaf2-2a61-4d48-9b95-4be00fd30d357ca2df41-2d15-433b-afdc-476e1cb40eef</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>0acccaf2-2a61-4d48-9b95-4be00fd30d35</b:FlowGuid><b:Id>496</b:Id><b:InteractionKey>04a79eec-77ec-4a54-8692-7a2c1a862ba7:0acccaf2-2a61-4d48-9b95-4be00fd30d35:7ca2df41-2d15-433b-afdc-476e1cb40eef</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>azlocal-vmc May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo may be able to remotely execute code for azlocal-vmc.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>10. vmc binary is injected via iso 12. mTLS certs are injected via TLS encrypted RPC. 14. EnableArcAgent gRPC API is invoked with the required config as args including the rsa private key from step 7. 18. short lived TLS cert is rotated in exchange for a long lived leaf cert (1 year)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>04a79eec-77ec-4a54-8692-7a2c1a862ba7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7ca2df41-2d15-433b-afdc-476e1cb40eef</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E504a79eec-77ec-4a54-8692-7a2c1a862ba70acccaf2-2a61-4d48-9b95-4be00fd30d357ca2df41-2d15-433b-afdc-476e1cb40eef</a:Key><a:Value xmlns:b="http://schemas.datacon