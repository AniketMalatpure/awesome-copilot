g><a:Key>UserThreatDescription</a:Key><a:Value>azcmagent (optional) may be able to impersonate the context of azlocal-vmc in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Process start</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b1226ef7-0b7f-4404-8e34-7be088b9f7c5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>143400a1-41b1-4794-aba1-9f5777433278</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1143400a1-41b1-4794-aba1-9f5777433278b689e93f-91b4-49c2-94fd-823551d95fcffbfcbc3f-b473-4faa-995b-e7ddfa06f921</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f2963659-3f3c-4bde-aadb-d2b6df386b61</b:DrawingSurfaceGuid><b:FlowGuid>b689e93f-91b4-49c2-94fd-823551d95fcf</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>143400a1-41b1-4794-aba1-9f5777433278:b689e93f-91b4-49c2-94fd-823551d95fcf:fbfcbc3f-b473-4faa-995b-e7ddfa06f921</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the azcmagent (optional) Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azcmagent (optional) may be spoofed by an attacker and this may lead to unauthorized access to ARC RP. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTPS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>143400a1-41b1-4794-aba1-9f5777433278</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fbfcbc3f-b473-4faa-995b-e7ddfa06f921</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6143400a1-41b1-4794-aba1-9f5777433278b689e93f-91b4-49c2-94fd-823551d95fcffbfcbc3f-b473-4faa-995b-e7ddfa06f921</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f2963659-3f3c-4bde-aadb-d2b6df386b61</b:DrawingSurfaceGuid><b:FlowGuid>b689e93f-91b4-49c2-94fd-823551d95fcf</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>143400a1-41b1-4794-aba1-9f5777433278:b689e93f-91b4-49c2-94fd-823551d95fcf:fbfcbc3f-b473-4faa-995b-e7ddfa06f921</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by ARC RP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>ARC RP claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTPS</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>143400a1-41b1-4794-aba1-9f5777433278</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>fbfcbc3f-b473-4faa-995b-e7ddfa06f921</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3143400a1-41b1-4794-aba1-9f5777433278b689e93f-91b4-49c2-94fd-823551d95fcffbfcbc3f-b473-4faa-995b-e7ddfa06f921</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>f2963659-3f3c-4bde-aadb-d2b6df386b61</b:DrawingSurfaceGuid><b:FlowGuid>b689e93f-91b4-49c2-94fd-823551d95fcf</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>143400a1-41b1-4794-aba1-9f5777433278:b689e93f-91b4-49c2-94fd-823551d95fcf:fbfcbc3f-b473-4faa-995b-e7ddfa06f921</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for ARC R