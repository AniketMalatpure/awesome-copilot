68-8db8-71eff5f9a169:2da3e4df-1bb0-4c43-b9e3-f635100f5050</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Hybrid Compute May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azcmagent may be able to remotely execute code for Hybrid Compute.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>From azcmagent to Hybrid Compute via unnamed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>137b7f37-2b24-4cb1-853f-d47e5a27f824</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2da3e4df-1bb0-4c43-b9e3-f635100f5050</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7137b7f37-2b24-4cb1-853f-d47e5a27f8244e7ad9b7-c283-4868-8db8-71eff5f9a1692da3e4df-1bb0-4c43-b9e3-f635100f5050</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>4e7ad9b7-c283-4868-8db8-71eff5f9a169</b:FlowGuid><b:Id>318</b:Id><b:InteractionKey>137b7f37-2b24-4cb1-853f-d47e5a27f824:4e7ad9b7-c283-4868-8db8-71eff5f9a169:2da3e4df-1bb0-4c43-b9e3-f635100f5050</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Hybrid Compute</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Hybrid Compute in order to change the flow of program execution within Hybrid Compute to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>From azcmagent to Hybrid Compute via unnamed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>137b7f37-2b24-4cb1-853f-d47e5a27f824</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2da3e4df-1bb0-4c43-b9e3-f635100f5050</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1e8b47e36-aff7-422e-8758-5b75d3f9446322b047ee-0c71-42bc-8cc3-7ffe33560799a522cdeb-b2ed-4eb2-bdaf-9c21db685783</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>22b047ee-0c71-42bc-8cc3-7ffe33560799</b:FlowGuid><b:Id>329</b:Id><b:InteractionKey>e8b47e36-aff7-422e-8758-5b75d3f94463:22b047ee-0c71-42bc-8cc3-7ffe33560799:a522cdeb-b2ed-4eb2-bdaf-9c21db685783</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store etcd</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>etcd may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of etcd. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>From Kubernetes API Server to etcd via unnamed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e8b47e36-aff7-422e-8758-5b75d3f94463</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a522cdeb-b2ed-4eb2-bdaf-9c21db685783</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2e8b47e36-aff7-422e-8758-5b75d3f9446322b047ee-0c71-42bc-8cc3-7ffe33560799a522cdeb-b2ed-4eb2-bdaf-9c21db685783</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>22b047ee-0c71-42bc-8cc3-7ffe33560799</b:FlowGuid><b:Id>330</b:Id><b:InteractionKey>e8b47e36-aff7-422e-8758-5b75d3f94463:22b047ee-0c71-42bc-8cc3-7ffe33560799:a522cdeb-b2ed-4eb2-bdaf-9c21db685783</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Kubernetes API Server or etcd</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Kubernetes API Server or etcd take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>From Kubernetes API Server to etcd via unnamed</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e8b47e36-aff7-422e-8758-5b75d3f94463</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a522cdeb-b2ed-4eb2-bdaf-9c21db685783</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1e899895e-9794-4a38-b6d9-d0e0cd12398ab7c9a01a-e654-42c1-ae66-eec6c49737f6bcfc8612-9895-47f5-aa68-d7d61b79eab7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>b7c9a01a-e654-42c1-ae66-eec6c49737f6</b:FlowGuid><b:Id>331</b:Id><b:InteractionKey>e899895e-9794-4a38-b6d9-d0e0cd12398a:b7c9a01a-e654-42c1-ae66-eec6c49737f6:bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Azure Key Vault A4S ext Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Azure Key Vault A4S ext may be spoofed by an attacker and this may lead to unauthorized access to Azure Key Vault. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>17. The long lived vmc TLS cert is synced into the node windows cert store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e899895e-9794-4a38-b6d9-d0e0cd12398a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6e899895e-9794-4a38-b6d9-d0e0cd12398ab7c9a01a-e654-42c1-ae66-eec6c49737f6bcfc8612-9895-47f5-aa68-d7d61b79eab7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>b7c9a01a-e654-42c1-ae66-eec6c49737f6</b:FlowGuid><b:Id>332</b:Id><b:InteractionKey>e899895e-9794-4a38-b6d9-d0e0cd12398a:b7c9a01a-e654-42c1-ae66-eec6c49737f6:bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Azure Key Vault</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Azure Key Vault claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>17. The long lived vmc TLS cert is synced into the node windows cert store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e899895e-9794-4a38-b6d9-d0e0cd12398a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3e899895e-9794-4a38-b6d9-d0e0cd12398ab7c9a01a-e654-42c1-ae66-eec6c49737f6bcfc8612-9895-47f5-aa68-d7d61b79eab7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>b7c9a01a-e654-42c1-ae66-eec6c49737f6</b:FlowGuid><b:Id>333</b:Id><b:InteractionKey>e899895e-9794-4a38-b6d9-d0e0cd12398a:b7c9a01a-e654-42c1-ae66-eec6c49737f6:bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Azure Key Vault</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Azure Key Vault crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>17. The long lived vmc TLS cert is synced into the node windows cert store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e899895e-9794-4a38-b6d9-d0e0cd12398a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4e899895e-9794-4a38-b6d9-d0e0cd12398ab7c9a01a-e654-42c1-ae66-eec6c49737f6bcfc8612-9895-47f5-aa68-d7d61b79eab7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>b7c9a01a-e654-42c1-ae66-eec6c49737f6</b:FlowGuid><b:Id>334</b:Id><b:InteractionKey>e899895e-9794-4a38-b6d9-d0e0cd12398a:b7c9a01a-e654-42c1-ae66-eec6c49737f6:bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow 17. The long lived vmc TLS cert is synced into the node windows cert store Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>17. The long lived vmc TLS cert is synced into the node windows cert store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e899895e-9794-4a38-b6d9-d0e0cd12398a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5e899895e-9794-4a38-b6d9-d0e0cd12398ab7c9a01a-e654-42c1-ae66-eec6c49737f6bcfc8612-9895-47f5-aa68-d7d61b79eab7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>b7c9a01a-e654-42c1-ae66-eec6c49737f6</b:FlowGuid><b:Id>335</b:Id><b:InteractionKey>e899895e-9794-4a38-b6d9-d0e0cd12398a:b7c9a01a-e654-42c1-ae66-eec6c49737f6:bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Azure Key Vault may be able to impersonate the context of Azure Key Vault A4S ext in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>17. The long lived vmc TLS cert is synced into the node windows cert store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e899895e-9794-4a38-b6d9-d0e0cd12398a</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6e899895e-9794-4a38-b6d9-d0e0cd12398ab7c9a01a-e654-42c1-ae66-eec6c49737f6bcfc8612-9895-47f5-aa68-d7d61b79eab7</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>8c022810-2a7f-459b-98ff-72b811a8ed65</b:DrawingSurfaceGuid><b:FlowGuid>b7c9a01a-e654-42c1-ae66-eec6c49737f6</b:FlowGuid><b:Id>336</b:Id><b:InteractionKey>e899895e-9794-4a38-b6d9-d0e0cd12398a:b7c9a01a-e654-42c1-ae66-eec6c49737f6:bcfc8612-9895-47f5-aa68-d7d61b79eab7</b:InteractionKey><b:Inter