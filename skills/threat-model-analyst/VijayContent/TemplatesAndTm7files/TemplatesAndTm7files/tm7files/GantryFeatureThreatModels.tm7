tShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E786f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>779</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into azlocal-vmo in order to change the flow of program execution within azlocal-vmo to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E686f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>778</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>azlocal-vmo May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-overlay extension may be able to remotely execute code for azlocal-vmo.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E586f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>777</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo may be able to impersonate the context of azlocal-overlay extension in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D486f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>776</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D386f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>775</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I686f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>774</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R686f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>773</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T186f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>772</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made may be tampered with by an attacker. This may lead to a denial of service attack against azlocal-vmo or an elevation of privilege attack against azlocal-vmo or an information disclosure by azlocal-vmo. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S286f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>771</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the azlocal-vmo Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo may be spoofed by an attacker and this may lead to information disclosure by azlocal-overlay extension. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S186f907c2-97bb-4b57-899c-dfc2c71d1229997cd3da-cadd-4a97-9fa9-92baedce8a55a6846a4f-3ffc-4d67-a493-ceb5e6827f56</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>7f106ba0-74a0-43a9-8da9-9f85847915d0</b:DrawingSurfaceGuid><b:FlowGuid>997cd3da-cadd-4a97-9fa9-92baedce8a55</b:FlowGuid><b:Id>770</b:Id><b:InteractionKey>86f907c2-97bb-4b57-899c-dfc2c71d1229:997cd3da-cadd-4a97-9fa9-92baedce8a55:a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the azlocal-overlay extension Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-overlay extension may be spoofed by an attacker and this may lead to unauthorized access to azlocal-vmo. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>gRPC (TLS + JWT) 6. NodeInventory is pulled from VMO every ~1 minute This includes VM and attached resource information, so no new calls to the VMO are being made</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>86f907c2-97bb-4b57-899c-dfc2c71d1229</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a6846a4f-3ffc-4d67-a493-ceb5e6827f56</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E586f907c2-97bb-4b57-899c-dfc2c71d122