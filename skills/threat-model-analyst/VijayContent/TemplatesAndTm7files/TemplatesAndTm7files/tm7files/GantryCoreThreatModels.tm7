tringstring><a:Key>UserThreatDescription</a:Key><a:Value>File System (Admin ACLs) may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of File System (Admin ACLs). Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#12 #13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd17353e-7f97-4a36-b94e-9f7e3c72f2b5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bea5a819-ba9d-405a-a7a3-b5436b17107a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2cd17353e-7f97-4a36-b94e-9f7e3c72f2b5823b96ba-96bf-4cd4-932d-303f4dc2b5fcbea5a819-ba9d-405a-a7a3-b5436b17107a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>969edf51-46ab-4ca8-8e87-5a547bf9eebe</b:DrawingSurfaceGuid><b:FlowGuid>823b96ba-96bf-4cd4-932d-303f4dc2b5fc</b:FlowGuid><b:Id>709</b:Id><b:InteractionKey>cd17353e-7f97-4a36-b94e-9f7e3c72f2b5:823b96ba-96bf-4cd4-932d-303f4dc2b5fc:bea5a819-ba9d-405a-a7a3-b5436b17107a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for azlocal-vmc or File System (Admin ACLs)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does azlocal-vmc or File System (Admin ACLs) take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#12 #13</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cd17353e-7f97-4a36-b94e-9f7e3c72f2b5</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>bea5a819-ba9d-405a-a7a3-b5436b17107a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5ca80135b-891f-4f42-96e4-853d0346d5ea20da63d6-ed56-471b-a338-31f07968492fca80135b-891f-4f42-96e4-853d0346d5ea</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>969edf51-46ab-4ca8-8e87-5a547bf9eebe</b:DrawingSurfaceGuid><b:FlowGuid>20da63d6-ed56-471b-a338-31f07968492f</b:FlowGuid><b:Id>717</b:Id><b:InteractionKey>ca80135b-891f-4f42-96e4-853d0346d5ea:20da63d6-ed56-471b-a338-31f07968492f:ca80135b-891f-4f42-96e4-853d0346d5ea</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T