atpc_P0_PhOB><a:Key>D32fb164a2-ee1c-4bef-a2fc-0ad39bbe09fce8754381-78db-4275-bf37-c24a15e0b5f4cf035149-f549-4b5d-a1c4-8cb5b1ace17d</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>e8754381-78db-4275-bf37-c24a15e0b5f4</b:FlowGuid><b:Id>833</b:Id><b:InteractionKey>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc:e8754381-78db-4275-bf37-c24a15e0b5f4:cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I62fb164a2-ee1c-4bef-a2fc-0ad39bbe09fce8754381-78db-4275-bf37-c24a15e0b5f4cf035149-f549-4b5d-a1c4-8cb5b1ace17d</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>e8754381-78db-4275-bf37-c24a15e0b5f4</b:FlowGuid><b:Id>832</b:Id><b:InteractionKey>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc:e8754381-78db-4275-bf37-c24a15e0b5f4:cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across #1 may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R62fb164a2-ee1c-4bef-a2fc-0ad39bbe09fce8754381-78db-4275-bf37-c24a15e0b5f4cf035149-f549-4b5d-a1c4-8cb5b1ace17d</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>e8754381-78db-4275-bf37-c24a15e0b5f4</b:FlowGuid><b:Id>831</b:Id><b:InteractionKey>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc:e8754381-78db-4275-bf37-c24a15e0b5f4:cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-vmo claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T12fb164a2-ee1c-4bef-a2fc-0ad39bbe09fce8754381-78db-4275-bf37-c24a15e0b5f4cf035149-f549-4b5d-a1c4-8cb5b1ace17d</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>e8754381-78db-4275-bf37-c24a15e0b5f4</b:FlowGuid><b:Id>830</b:Id><b:InteractionKey>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc:e8754381-78db-4275-bf37-c24a15e0b5f4:cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for azlocal-vmo</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across #1 may be tampered with by an attacker. This may lead to a denial of service attack against azlocal-vmo or an elevation of privilege attack against azlocal-vmo or an information disclosure by azlocal-vmo. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#1</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2fb164a2-ee1c-4bef-a2fc-0ad39bbe09fc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>cf035149-f549-4b5d-a1c4-8cb5b1ace17d</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6154ea03d-6ff8-4bea-9b4e-65afd82d0c38ce484024-b2a2-4cb2-91dc-ca164d27cd179e7be672-1875-4b89-ad8a-19813870fe65</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>ce484024-b2a2-4cb2-91dc-ca164d27cd17</b:FlowGuid><b:Id>851</b:Id><b:InteractionKey>154ea03d-6ff8-4bea-9b4e-65afd82d0c38:ce484024-b2a2-4cb2-91dc-ca164d27cd17:9e7be672-1875-4b89-ad8a-19813870fe65</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by azlocal-overlay extension</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-overlay extension claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>154ea03d-6ff8-4bea-9b4e-65afd82d0c38</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e7be672-1875-4b89-ad8a-19813870fe65</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1154ea03d-6ff8-4bea-9b4e-65afd82d0c38ce484024-b2a2-4cb2-91dc-ca164d27cd179e7be672-1875-4b89-ad8a-19813870fe65</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>ce484024-b2a2-4cb2-91dc-ca164d27cd17</b:FlowGuid><b:Id>850</b:Id><b:InteractionKey>154ea03d-6ff8-4bea-9b4e-65afd82d0c38:ce484024-b2a2-4cb2-91dc-ca164d27cd17:9e7be672-1875-4b89-ad8a-19813870fe65</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for azlocal-overlay extension</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across #8 may be tampered with by an attacker. This may lead to a denial of service attack against azlocal-overlay extension or an elevation of privilege attack against azlocal-overlay extension or an information disclosure by azlocal-overlay extension. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>154ea03d-6ff8-4bea-9b4e-65afd82d0c38</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e7be672-1875-4b89-ad8a-19813870fe65</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2154ea03d-6ff8-4bea-9b4e-65afd82d0c38ce484024-b2a2-4cb2-91dc-ca164d27cd179e7be672-1875-4b89-ad8a-19813870fe65</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>ce484024-b2a2-4cb2-91dc-ca164d27cd17</b:FlowGuid><b:Id>849</b:Id><b:InteractionKey>154ea03d-6ff8-4bea-9b4e-65afd82d0c38:ce484024-b2a2-4cb2-91dc-ca164d27cd17:9e7be672-1875-4b89-ad8a-19813870fe65</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the azlocal-overlay extension Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>azlocal-overlay extension may be spoofed by an attacker and this may lead to information disclosure by KubernetesConfiguration RP. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>154ea03d-6ff8-4bea-9b4e-65afd82d0c38</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e7be672-1875-4b89-ad8a-19813870fe65</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S1154ea03d-6ff8-4bea-9b4e-65afd82d0c38ce484024-b2a2-4cb2-91dc-ca164d27cd179e7be672-1875-4b89-ad8a-19813870fe65</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>ce484024-b2a2-4cb2-91dc-ca164d27cd17</b:FlowGuid><b:Id>848</b:Id><b:InteractionKey>154ea03d-6ff8-4bea-9b4e-65afd82d0c38:ce484024-b2a2-4cb2-91dc-ca164d27cd17:9e7be672-1875-4b89-ad8a-19813870fe65</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the KubernetesConfiguration RP Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>KubernetesConfiguration RP may be spoofed by an attacker and this may lead to unauthorized access to azlocal-overlay extension. Consider using a standard authentication mechanism to identify the source process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>154ea03d-6ff8-4bea-9b4e-65afd82d0c38</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>9e7be672-1875-4b89-ad8a-19813870fe65</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7cc877443-b9d0-41f9-940b-b743860176e7187f8118-443f-4cba-8193-19db928895ba154ea03d-6ff8-4bea-9b4e-65afd82d0c38</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>2bc9cc67-490d-4caa-9ef6-6686c5966aeb</b:DrawingSurfaceGuid><b:FlowGuid>187f8118-443f-4cba-8193-19db928895ba</b:FlowGuid><b:Id>847</b:Id><b:InteractionKey>cc877443-b9d0-41f9-940b-b743860176e7:187f8118-443f-4cba-8193-19db928895ba:154ea03d-6ff8-4bea-9b4e-65afd82d0c38</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in KubernetesConfiguration RP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into KubernetesConfiguration RP in order to change the flow of program execution within KubernetesConfiguration RP to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>#8</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>cc877443-b9d0-41f9-940b-b743860176e7</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i